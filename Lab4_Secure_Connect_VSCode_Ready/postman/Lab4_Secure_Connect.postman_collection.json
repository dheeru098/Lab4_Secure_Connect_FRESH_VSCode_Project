    },
    {
      "name": "Get Deleted Note (expected 404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notes/{{noteId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notes",
            "{{noteId}}"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Deleted note not found\", () => pm.response.to.have.status(404));"
            ]
          }
        }
